        "import whisper\n",
        "import time\n",
        "import torch # GPU kontrolü için (yüklü değilse hata vermez, try-except var)\n",
        "\n",
        "def uzun_kaydi_cevir(dosya_yolu):\n",
        "    start_time = time.time()\n",
        "\n",
        "    # 1. Donanım Kontrolü (Ekran kartı varsa onu kullanır, yoksa işlemci)\n",
        "    cihaz = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
        "    print(f\"⚙️ Çalışma modu: {cihaz.upper()} (GPU kullanılması hızı 10 kat artırır)\")\n",
        "\n",
        "    if cihaz == \"cpu\":\n",
        "        print(\"⚠️ UYARI: İşlemci (CPU) kullanılıyor. 2 saatlik kayıt uzun sürebilir.\")\n",
        "        print(\"   Bilgisayarın donmasını önlemek için 'base' veya 'tiny' modelini kullanıyoruz.\")\n",
        "\n",
        "    print(\"🧠 Model yükleniyor...\")\n",
        "    # Modeller: tiny < base < small < medium < large\n",
        "    # 2 saatlik kayıt için 'base' iyi bir dengedir. Daha iyi kalite için 'small' deneyebilirsiniz.\n",
        "    model = whisper.load_model(\"base\", device=cihaz)\n",
        "\n",
        "    print(f\"📂 '{dosya_yolu}' işleniyor. Lütfen programı kapatmayın...\")\n",
        "    print(\"ℹ️ İpucu: Bu işlem sırasında siyah ekranda metinlerin aktığını göreceksiniz.\")\n",
        "\n",
        "    # verbose=True sayesinde anlık olarak çevrilen kısımları ekrana yazar\n",
        "    result = model.transcribe(dosya_yolu, fp16=False, language='tr', verbose=True)\n",
        "\n",
        "    tam_metin = result[\"text\"]\n",
        "\n",
        "    # Dosyaya Kaydetme\n",
        "    kayit_adi = \"deşifre_tam_metin.txt\"\n",
        "    with open(kayit_adi, \"w\", encoding=\"utf-8\") as f:\n",
        "        f.write(tam_metin)\n",
        "\n",
        "    gecen_sure = (time.time() - start_time) / 60\n",
        "    print(f\"\\n✅ İşlem Tamamlandı! Toplam süre: {gecen_sure:.1f} dakika.\")\n",
        "    print(f\"📄 Metin şuraya kaydedildi: {kayit_adi}\")\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    dosya = \"seskaydi.m4a\" # Buraya dosya adınızı yazın\n",
        "    uzun_kaydi_cevir(dosya)"
